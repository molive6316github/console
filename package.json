{
  "name": "mxt-console",
  "version": "0.12.0",
  "type": "module",
  "description": "Web dashboard for starting, stopping and watching all kinds of servers. One-click Minecraft, Docker and Node setups, backups, schedules.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "node --watch server/src/index.js",
    "dev:web": "vite web",
    "build": "vite build web",
    "start": "node bin/supervise.js",
    "test": "node --test \"server/test/*.test.js\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.3.7",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "fastify": "^5.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "vite": "^7.0.0"
  },
  "bin": {
    "mxt-console": "bin/mxt-console.js"
  },
  "files": [
    "bin",
    "server/src",
    "server/plugins",
    "PLUGINS.md",
    "web/dist",
    "deploy",
    "install.sh",
    "servers.example.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molive6316github/console.git"
  },
  "homepage": "https://github.com/molive6316github/console#readme",
  "bugs": {
    "url": "https://github.com/molive6316github/console/issues"
  },
  "keywords": [
    "server-manager",
    "dashboard",
    "minecraft",
    "tmux",
    "systemd",
    "docker",
    "self-hosted"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
