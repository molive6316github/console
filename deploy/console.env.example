# Copy to /etc/console.env, then: sudo chmod 600 /etc/console.env && sudo chown root:root /etc/console.env

# Keep this on loopback. Caddy is the only thing that faces the internet.
HOST=127.0.0.1
PORT=3000

# You are behind HTTPS + a reverse proxy, so turn these on.
CONSOLE_SECURE_COOKIES=1
CONSOLE_TRUST_PROXY=1

# Only used on the very first start (when there are no users yet). Use something long.
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=change-me-to-something-long

# Where the data and server list live
CONSOLE_DB=/opt/console/data/console.db
CONSOLE_SERVERS=/opt/console/servers.json
