{
  "name": "console",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Web dashboard for starting, stopping and watching all kinds of servers",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "node --watch server/src/index.js",
    "dev:web": "vite web",
    "build": "vite build web",
    "start": "node server/src/index.js",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.3.7",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "vite": "^7.0.0"
  }
}
