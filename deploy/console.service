[Unit]
Description=Console server dashboard
After=network.target

[Service]
Type=simple
User=console
WorkingDirectory=/opt/console
EnvironmentFile=/etc/console.env
# Change the path if node lives elsewhere (check: which node)
ExecStart=/usr/bin/node server/src/index.js
# on-failure matters: the in-dashboard updater restarts Console by exiting with code 75.
Restart=on-failure
RestartSec=3

# Restarting the dashboard must NOT kill the game servers it started in tmux.
KillMode=process

NoNewPrivileges=true

# Lets Console's built-in nameserver listen on port 53 without being root.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
